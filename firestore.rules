rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function shortText(v, limit) { return v is string && v.size() <= limit; }
  function email(v) { return shortText(v,254) && (v == '' || v.matches('^[^ @]+@[^ @]+[.][^ @]+$')); }
  function url(v) { return shortText(v,2000) && (v == '' || v.matches('^https?://[^ ].*$')); }
  function member(m) {
   return m is map && m.keys().hasOnly(['name','role','email','notes','projectId','position'])
    && m.name is string && m.name.size() <= 200 && m.name.size() > 0 && m.role is string && m.role.size() <= 80 && m.role.size() > 0
    && m.email is string && m.email.size() <= 254 && m.email.matches('^[^ @]+@[^ @]+[.][^ @]+$') && m.notes is string && m.notes.size() <= 2000;
  }

  function valid(d) {
   return d.keys().hasAll(['name', 'description', 'status', 'environment', 'stack', 'localPath', 'githubAccount', 'githubEmail', 'githubRepo', 'branch', 'firebaseEmail', 'firebaseName', 'firebaseId', 'hostingSite', 'productionUrl', 'domain', 'deployMethod', 'lastDeployed', 'notes', 'createdAt', 'updatedAt']) && d.keys().hasOnly(['name', 'description', 'status', 'environment', 'stack', 'localPath', 'githubAccount', 'githubEmail', 'githubRepo', 'branch', 'firebaseEmail', 'firebaseName', 'firebaseId', 'hostingSite', 'productionUrl', 'domain', 'deployMethod', 'lastDeployed', 'notes', 'createdAt', 'updatedAt'])
    && (d.name is string && d.name.size() <= 200)
    && (d.description is string && d.description.size() <= 2000)
    && (d.status is string && d.status.size() <= 2000)
    && (d.environment is string && d.environment.size() <= 2000)
    && (d.stack is string && d.stack.size() <= 2000)
    && (d.localPath is string && d.localPath.size() <= 2000)
    && (d.githubAccount is string && d.githubAccount.size() <= 2000)
    && email(d.githubEmail)
    && url(d.githubRepo)
    && (d.branch is string && d.branch.size() <= 2000)
    && email(d.firebaseEmail)
    && (d.firebaseName is string && d.firebaseName.size() <= 2000)
    && (d.firebaseId is string && d.firebaseId.size() <= 2000)
    && (d.hostingSite is string && d.hostingSite.size() <= 2000)
    && url(d.productionUrl)
    && (d.domain is string && d.domain.size() <= 2000)
    && (d.deployMethod is string && d.deployMethod.size() <= 2000)
    && (d.lastDeployed is string && d.lastDeployed.size() <= 2000)
    && (d.notes is string && d.notes.size() <= 2000)
    && d.name.size() > 0 && d.status in ['Active','In progress','On hold','Archived']
    && d.environment in ['Production','Staging','Development']
    && (d.lastDeployed == '' || d.lastDeployed.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
    && d.createdAt is timestamp && d.updatedAt == request.time
;
  }
  match /users/{uid}/projects/{projectId} {
   allow read, delete: if owner(uid);
   allow create: if owner(uid) && valid(request.resource.data) && request.resource.data.createdAt == request.time;
   allow update: if owner(uid) && valid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
  }
  match /users/{uid}/mappings/{mappingId} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && member(request.resource.data)
    && request.resource.data.projectId is string
    && request.resource.data.position is int
    && request.resource.data.position >= 0 && request.resource.data.position < 12
    && mappingId == request.resource.data.projectId + '_' + string(request.resource.data.position)
    && existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(request.resource.data.projectId));
  }
  // Everything outside the explicitly allowed project path is denied.
 }
}
